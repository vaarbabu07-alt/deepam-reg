# DEEPAM'26 — MULTI DISTRICT MEETING — Production Environment Template
# Copy this file to .env and configure your production values.
# NEVER commit the real .env file with secrets into version control.
# IMPORTANT: Do NOT wrap values in quotes. Node.js dotenv includes quotes literally.

# Server Configuration (GoDaddy / local port)
PORT=3001

# Event Information
EVENT_NAME=DEEPAM'26 — MULTI DISTRICT MEETING
DISTRICT_NAME=Rotary International District 3231
EVENT_DATE=27th & 28th November 2026
EVENT_VENUE=Andal Singaravelu Kalyana Mandapam, Vengikkal, Tiruvannamalai

# Registration Fees (INR per person)
ROTARIAN_FEE=1200
ANNS_FEE=1000
ANNETTES_FEE=1000

# Participant Limits
MAX_ROTARIANS=10
MAX_ANNS=50
MAX_ANNETTES=50

# UPI Payment Details
UPI_ID=73600301@ubin
PAYEE_NAME=ROTARY CLUB

# Administrator Dashboard Credentials (Change these for production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
SESSION_SECRET=your_random_64_char_session_secret_token_here

# Admin Notification Email
ADMIN_EMAIL=deepammdm26@gmail.com

# SMTP Email Configuration (e.g. Gmail SMTP with 16-character App Password, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sending_email@gmail.com
SMTP_PASS=your16charapppasswordwithoutspaces
SMTP_FROM=DEEPAM'26 <your_sending_email@gmail.com>

# Official Google Sheets API Integration (Google Cloud Service Account)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvwIBADANBgkq...your_full_pem_key_here...\n-----END PRIVATE KEY-----"

# Google Sheets Webhook Integration (Optional Fallback - Apps Script Web App URL)
GOOGLE_SHEETS_WEBHOOK_URL=

# Upload Limits (MB)
UPLOAD_MAX_SIZE_MB=5

# WhatsApp Business Cloud API Integration (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=deepam26_registration_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en
